{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_PYTHON_API_URL": "http://192.168.187.56:8000",
        "EXPO_PUBLIC_NODE_API_URL": "http://192.168.187.56:3000"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_PYTHON_API_URL": "https://khidmat-api.example.com",
        "EXPO_PUBLIC_NODE_API_URL": "https://khidmat-worker.example.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_PYTHON_API_URL": "https://khidmat-api.example.com",
        "EXPO_PUBLIC_NODE_API_URL": "https://khidmat-worker.example.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
