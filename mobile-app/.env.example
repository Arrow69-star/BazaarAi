# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Backend URLs. For Expo Go on a phone these must be your PC's LAN IP, not localhost.
EXPO_PUBLIC_PYTHON_API_URL=http://192.168.1.100:8000
EXPO_PUBLIC_NODE_API_URL=http://192.168.1.100:3000

# Google Maps key used by the client. Note: EXPO_PUBLIC_* values are embedded in the
# app bundle and are therefore readable by anyone with the APK — that is unavoidable
# for a client-side Maps key. Protect it in GCP Console with an Android app
# restriction (package com.bazaarai.app + SHA-1 fingerprint), not by hiding it.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-restricted-maps-key
