# Khidmat AI — Python (canonical) backend for Google Cloud Run.
# The Node Dockerfile builds the legacy pipeline that is being retired; this is the one to deploy.
FROM python:3.12-slim

# Keeps the image small and logs unbuffered so Cloud Logging sees output immediately.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencies first so this layer caches across code changes.
COPY python-agents/requirements.txt ./python-agents/requirements.txt
RUN pip install --no-cache-dir -r python-agents/requirements.txt

# The agents resolve providers.json as ../data/providers.json, so the repo-root
# data/ directory has to sit alongside python-agents/ exactly as it does in the repo.
COPY data/ ./data/
COPY python-agents/ ./python-agents/

# Runtime writes (bookings.json, agent_trace.jsonl) need a writable owner.
RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /app/python-agents/data /app/python-agents/logs /app/python-agents/agents/logs \
    && chown -R appuser:appuser /app
USER appuser

WORKDIR /app/python-agents

# Cloud Run / Render inject PORT. Shell form so the variable expands.
ENV PORT=8080
EXPOSE 8080

# Seed before serving: on a host with an ephemeral filesystem the SQLite database is
# empty on every boot, and an unseeded database means zero providers and no bookable
# requests. seed_db.py is idempotent, so this is also safe against a persistent
# Postgres (it updates providers rather than duplicating them).
CMD exec sh -c "python seed_db.py && exec uvicorn main:app --host 0.0.0.0 --port ${PORT} --workers 1"

